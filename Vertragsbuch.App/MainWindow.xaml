<Window x:Class="Vertragsbuch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Vertragsbuch.App"
        mc:Ignorable="d"
        Language="de-DE"
        Title="Vertragsbuch" Height="500" Width="800">

    <!-- Hauptgrid: Kopfzeile / Liste / Eingabebereich -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Zeile 0: Überschrift und Anzahl -->
        <TextBlock FontSize="20" FontWeight="Heavy" Text="Meine Verträge" Grid.Row="0" Margin="10"/>
        <TextBlock x:Name="AnzahlTextBlock" FontSize="20" Grid.Row="0" HorizontalAlignment="Right" Text="Platzhalter" Margin="10"/>

        <!-- Zeile 1: Liste der Verträge -->
        <ListBox x:Name="VertragsListBox" Grid.Row="1" Margin="10" FontSize="16">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="{Binding Name}" Margin="0,0,15,0"/>
                        <TextBlock Text="{Binding Anbieter}" Margin="0,0,15,0"/>
                        <TextBlock Text="{Binding MonatlicheKosten, StringFormat=C}" Margin="0,0,15,0"/>
                        <TextBlock Text="{Binding Vertragsbeginn, StringFormat=d}" Margin="0,0,15,0"/>
                        <TextBlock Text="{Binding MindestlaufzeitMonate, StringFormat='Laufzeit: {0} Monate'}" Margin="0,0,15,0"/>
                        <TextBlock Text="{Binding KuendigungsfristMonate, StringFormat='Frist: {0} Monate'}" Margin="0,0,15,0"/>
                        <TextBlock Text="{Binding KuendigenBis, StringFormat='Kündigen bis: {0:d}'}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Zeile 2: Eingabebereich -->
        <Grid Grid.Row="2" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Zeile 0: Name -->
            <Label Content="Name:" Grid.Row="0" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="VertragsNameTextBox" Grid.Row="0" Grid.Column="1" Margin="0,3"/>

            <!-- Zeile 1: Anbieter -->
            <Label Content="Anbieter:" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="AnbieterTextBox" Grid.Row="1" Grid.Column="1" Margin="0,3"/>

            <!-- Zeile 2: Kosten -->
            <Label Content="Kosten pro Monat:" Grid.Row="2" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="KostenTextBox" Grid.Row="2" Grid.Column="1" Margin="0,3"/>

            <!-- Zeile 3: Vertragsbeginn -->
            <Label Content="Vertragsbeginn:" Grid.Row="3" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <DatePicker x:Name="VertragsbeginnDatePicker" Grid.Row="3" Grid.Column="1" Margin="0,3" HorizontalAlignment="Left"/>

            <!-- Zeile 4:  Mindestlaufzeit-->
            <Label Content="Mindestlaufzeit (Monate):" Grid.Row="4" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="MindestlaufzeitTextBox" Grid.Row="4" Grid.Column="1" Margin="0,3"/>

            <!-- Zeile 5: Kündigungsfrist -->
            <Label Content="Kündigungsfrist (Monate):" Grid.Row ="5" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="KuendigungsfristTextBox" Grid.Row ="5" Grid.Column="1" Margin="0,3"/>

            <!-- Zeile 6: Buttons -->
            <StackPanel Orientation="Horizontal" Grid.Row="6" Grid.Column="1" Margin="0,10,0,0">
                <Button x:Name="HinzufuegenButton" Content="Hinzufügen" Click="HinzufuegenButton_Click" Padding="10,3"/>
                <Button x:Name="EntfernenButton" Content="Entfernen" Click="EntfernenButton_Click" Margin="10,0,0,0" Padding="10,3"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>