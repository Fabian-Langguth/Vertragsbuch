<Window x:Class="Vertragsbuch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Vertragsbuch.App"
        mc:Ignorable="d"
        Title="Vertragsbuch" Height="500" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock FontSize="20" FontWeight="Heavy" Text="Meine Verträge" Grid.Row="0" Margin="10"/>
        <TextBlock x:Name="AnzahlTextBlock" FontSize="20" Grid.Row="0" HorizontalAlignment="Right" Text=" Platzhalter" Margin="10"/>
        <ListBox x:Name="VertragsListBox" Grid.Row="1"  Margin="10"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10">
            <TextBox x:Name="VertragsNameTextBox" Width="400"/>
            <Button x:Name="HinzufuegenButton" Content="Hinzufügen" Click="HinzufuegenButton_Click" Margin="10,0,0,0"/>
            <Button x:Name="EntfernenButton" Content=" Entfernen" Click="EntfernenButton_Click" Margin="10,0,0,0"/>
        </StackPanel>


    </Grid>
</Window>
