<Window x:Class="Vertragsbuch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Vertragsbuch.App"
        mc:Ignorable="d"
        Language="de-DE"
        Title="Vertragsbuch" Height="500" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock FontSize="20" FontWeight="Heavy" Text="Meine Verträge" Grid.Row="0" Margin="10"/>
        <TextBlock x:Name="AnzahlTextBlock" FontSize="20" Grid.Row="0" HorizontalAlignment="Right" Text="Platzhalter" Margin="10"/>
        <ListBox x:Name="VertragsListBox" Grid.Row="1" Margin="10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" Margin="0,0,15,0"/>
                        <TextBlock Text="{Binding Anbieter}" Margin="0,0,15,0"/>
                        <TextBlock Text="{Binding MonatlicheKosten, StringFormat=C}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="2" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Label Content="Name:" Grid.Row="0" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Label Content="Anbieter:" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Label Content="Kosten pro Monat:" Grid.Row="2" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="VertragsNameTextBox" Grid.Row="0" Grid.Column="1" Margin="0,3"/>
            <TextBox x:Name="AnbieterTextBox" Grid.Row="1" Grid.Column="1" Margin="0,3"/>
            <TextBox x:Name="KostenTextBox" Grid.Row="2" Grid.Column="1" Margin="0,3"/>
            <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="1" Margin="0,10,0,0">
                <Button x:Name="HinzufuegenButton" Content="Hinzufügen" Click="HinzufuegenButton_Click" Padding="10,3"/>
                <Button x:Name="EntfernenButton" Content="Entfernen" Click="EntfernenButton_Click" Margin="10,0,0,0" Padding="10,3"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
